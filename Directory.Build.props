<Project>
	<PropertyGroup>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>
			$(WarningsAsErrors);CS8600;CS8601;CS8602;CS8603;CS8604;CS8609;CS8610;CS8614;CS8616;CS8618;CS8619;CS8622;CS8625
		</WarningsAsErrors>
		<!--Masa 系列浮动版本 *-*:还原时解析各包最新版本(含预览,取所有启用源中最高)。
		普通 build 不重查;主动拉新用 dotnet restore 的 force-evaluate 选项;CI 可复现需配 packages.lock.json。-->
		<MasaFrameworkPackageVersion>*-*</MasaFrameworkPackageVersion>
		<MasaStackSdksPackageVersion>*-*</MasaStackSdksPackageVersion>
		<MicrosoftPackageVersion>6.0.7</MicrosoftPackageVersion>
	</PropertyGroup>
</Project>
