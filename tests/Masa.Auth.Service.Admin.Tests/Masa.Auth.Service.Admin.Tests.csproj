<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="SkiaSharp" />
    <!--TokenSchemeSelector 的 reference 句柄形状校验要锚定到 IS4 真实的句柄生成器（DefaultHandleGenerationService）：
        形状校验写严了，Reference 客户端会被本地 401；只有对着真实输出才测得出来-->
    <PackageReference Include="IdentityServer4.EntityFramework" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!--被测的应用/领域服务（QueryHandler、UserDomainService）在服务宿主项目里；PG 程序集由它传递引用-->
    <ProjectReference Include="..\..\src\Services\Masa.Auth.Service.Admin\Masa.Auth.Service.Admin.csproj" />
  </ItemGroup>

</Project>
