<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Pages\Account\Forget\**" />
		<Content Remove="Pages\Account\Forget\**" />
		<EmbeddedResource Remove="Pages\Account\Forget\**" />
		<None Remove="Pages\Account\Forget\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AlibabaCloud.SDK.Dypnsapi20170525" />
		<PackageReference Include="IdentityServer4.EntityFramework" />
		<PackageReference Include="Mapster" />
		<PackageReference Include="FluentValidation" />
		<PackageReference Include="Masa.Blazor" />
		<PackageReference Include="MASA.Lingua.SDK.MasaI18n" />
		<PackageReference Include="MASA.Lingua.SDK.MasaBlazor" />
		<PackageReference Include="Masa.Contrib.Authentication.OpenIdConnect.Cache.Storage" />
		<PackageReference Include="Masa.Contrib.StackSdks.Auth" />
		<PackageReference Include="Masa.Contrib.StackSdks.Mc" />
		<PackageReference Include="Masa.Contrib.StackSdks.Pm" />
		<PackageReference Include="Masa.Contrib.StackSdks.Tsc.OpenTelemetry" />
		<PackageReference Include="Masa.Contrib.Authentication.Identity" />
		<PackageReference Include="Masa.Contrib.Globalization.I18n.AspNetCore" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
		<PackageReference Include="Masa.Utils.Ldap.Novell" />
	</ItemGroup>

	<!--Lingua 离线兜底 + 同步落盘目录 = Assets/I18n（MASA I18n 原生资源目录，Lingua:LocalJsonDirectory 指向这里）：
	    语种 JSON 随构建拷到输出目录，Lingua 同步的最新版本会原地覆盖写回同一位置
	    （PreserveNewest：构建不反向覆盖比仓库快照更新的已同步文件）；
	    supportedCultures.json 是 MASA 的语种清单元数据，SDK 目录扫描/监听时会跳过（LinguaResourceFiles），不会当作语种加载。-->
	<ItemGroup>
		<Content Update="Assets\I18n\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Assets\" />
		<Folder Include="keys\" />
		<Folder Include="wwwroot\js\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Masa.Auth.Security.OAuth.Providers\Masa.Auth.Security.OAuth.Providers.csproj" />
	</ItemGroup>

	<ProjectExtensions>
		<VisualStudio>
			<UserProperties appsettings_1json__JsonSchema="" />
		</VisualStudio>
	</ProjectExtensions>

</Project>
